GEMINI_API_URL=your_gemini_api_url
GEMINI_API_KEY=your_gemini_api_key
FASTAPI_URL=http://0.0.0.0:8000
# Which LLM backend to use: ollama | gemini | groq
LLM_PROVIDER=ollama
# Local Ollama server (no API key needed)
OLLAMA_URL=http://localhost:11434

# NOTE: Fully offline mode. Progress is stored in a local SQLite database
# (data/local.db, gitignored). No Supabase services, auth servers, or
# Postgres are required or used.